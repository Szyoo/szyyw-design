{
  "name": "@szyyw/design",
  "version": "0.6.0",
  "description": "szyyw.xyz design language — tokens, glass components, interactive dot-field background. Framework-agnostic CSS/JS, no build step.",
  "type": "module",
  "license": "MIT",
  "repository": "github:Szyoo/szyyw-design",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./dotfield": {
      "types": "./dotfield.d.ts",
      "default": "./dotfield.js"
    },
    "./scheme": {
      "types": "./scheme.d.ts",
      "default": "./scheme.js"
    },
    "./settings": {
      "types": "./settings.d.ts",
      "default": "./settings.js"
    },
    "./corner": {
      "types": "./corner.d.ts",
      "default": "./corner.js"
    },
    "./version": {
      "types": "./version.d.ts",
      "default": "./version.js"
    }
  },
  "files": [
    "tokens.css",
    "components.css",
    "dotfield.js",
    "dotfield.d.ts",
    "scheme.js",
    "scheme.d.ts",
    "settings.js",
    "settings.d.ts",
    "corner.js",
    "corner.d.ts",
    "version.js",
    "version.d.ts",
    "DESIGN.md"
  ]
}
